@model List<TaskBoard.Web.Models.TaskItem>

<h1>Tasks</h1>

<div>
    <p>
        Hoş geldin, <strong>@User.Identity?.Name</strong>
    </p>

    <p>
        Rol:
        <strong>
            @(User.IsInRole("Admin") ? "Admin" : "User")
        </strong>
    </p>

    <form asp-controller="Login"
          asp-action="Logout"
          method="post">
        <button type="submit">
            Çıkış Yap
        </button>
    </form>
</div>

<hr />

@if (Model.Count == 0)
{
    <p>Henüz görev bulunmuyor.</p>
}
else
{
    <table>
        <thead>
            <tr>
                <th>ID</th>
                <th>Görev</th>
                <th>Öncelik</th>
                <th>İşlem</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var task in Model)
            {
                <tr>
                    <td>@task.Id</td>
                    <td>@task.Title</td>
                    <td>@task.Priority</td>

                    <td>
                        @if (User.IsInRole("Admin"))
                        {
                            <button type="button">
                                Sil
                            </button>
                        }
                        else
                        {
                            <span>Yetki yok</span>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}